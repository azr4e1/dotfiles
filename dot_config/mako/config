# Layout, matching niri's gaps and corner radius
anchor=top-right
margin=10
padding=12
width=360
border-size=2
border-radius=10

# Colours, matching the focus ring and dark theme
background-color=#1f1f28ee
text-color=#dcd7ba
border-color=#7fb4ca
progress-color=over #7e9cd855

# Timeout in ms
default-timeout=5000
ignore-timeout=0

layer=overlay

[urgency=low]
border-color=#727169
default-timeout=3000

[urgency=high]
border-color=#e82424
default-timeout=0

[app-name=osd]
anchor=bottom-center
width=260
history=0

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=high]
invisible=0
