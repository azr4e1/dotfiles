#!/usr/bin/env bash
# Wi-Fi menu for fuzzel. Requires: NetworkManager (nmcli), fuzzel, libnotify (optional).
# Selecting the active network disconnects it; saved networks reconnect without a prompt.

menu() { fuzzel --dmenu --width 60 --lines 12 "$@"; }
notify() { notify-send -a wifi "$@" 2>/dev/null; }

if [ "$(nmcli radio wifi)" != "enabled" ]; then
    choice=$(printf 'Enable Wi-Fi\n' | menu -p 'Wi-Fi is off > ') || exit 0
    [ -n "$choice" ] || exit 0
    nmcli radio wifi on
    sleep 2
fi

build_list() {
    printf 'Rescan\n'
    printf 'Disable Wi-Fi\n'
    # SSID is the last field so colons inside it survive (-e no disables escaping).
    nmcli -t -e no -f IN-USE,SIGNAL,SECURITY,SSID device wifi list --rescan no \
        | while IFS=: read -r inuse signal sec ssid; do
            [ -n "$ssid" ] || continue
            [ -n "$sec" ] || sec="open"
            sec=${sec// //}
            mark="  "; [ "$inuse" = "*" ] && mark="* "
            printf '%s%03d%% %-10s %s\n' "$mark" "$signal" "$sec" "$ssid"
        done \
        | sort -t' ' -k1.3,1.5 -rn -s \
        | awk '{ ssid=$0; sub(/^.{2}[0-9]+% +[^ ]+ +/, "", ssid); if (!seen[ssid]++) print }'
}

choice=$(build_list | menu -p 'Wi-Fi > ') || exit 0
[ -n "$choice" ] || exit 0

case "$choice" in
    "Rescan")
        notify "Wi-Fi" "Scanning..."
        nmcli device wifi rescan >/dev/null 2>&1
        sleep 3
        exec "$0"
        ;;
    "Disable Wi-Fi")
        nmcli radio wifi off
        notify "Wi-Fi" "Disabled"
        exit 0
        ;;
esac

active=0; [[ "$choice" == "* "* ]] && active=1
ssid=$(sed -E 's/^.{2}[0-9]+% +[^ ]+ +//' <<<"$choice")
sec=$(sed -E 's/^.{2}[0-9]+% +([^ ]+) .*/\1/' <<<"$choice")

if [ "$active" -eq 1 ]; then
    if nmcli connection down id "$ssid" >/dev/null 2>&1; then
        notify "Wi-Fi" "Disconnected from $ssid"
    else
        notify -u critical "Wi-Fi" "Failed to disconnect from $ssid"
    fi
    exit 0
fi

if nmcli -g NAME connection show | grep -Fxq -- "$ssid"; then
    cmd=(nmcli connection up id "$ssid")
elif [ "$sec" = "open" ]; then
    cmd=(nmcli device wifi connect "$ssid")
else
    pw=$(printf '' | fuzzel --dmenu --password --lines 0 --width 40 -p "Password for $ssid > ") || exit 0
    [ -n "$pw" ] || exit 0
    cmd=(nmcli device wifi connect "$ssid" password "$pw")
fi

notify "Wi-Fi" "Connecting to $ssid..."
if out=$("${cmd[@]}" 2>&1); then
    notify "Wi-Fi" "Connected to $ssid"
else
    notify -u critical "Wi-Fi" "Failed to connect to $ssid: ${out##*$'\n'}"
    exit 1
fi
